{
  "name": "@d-red/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./styles/*": "./styles/*",
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "@d-red/types": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@d-red/eslint-config": "workspace:*",
    "@d-red/tsconfig": "workspace:*",
    "@types/react": "^19",
    "eslint": "^9",
    "typescript": "^5"
  }
}
