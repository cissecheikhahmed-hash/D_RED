EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ATTENTION : cette clé est embarquée dans le bundle client (EXPO_PUBLIC_*),
# donc extractible par quiconque a l'app. Elle ne protège que contre une
# lecture QR "classique" (scanner grand public), pas contre un attaquant qui
# décompile l'app. Voir lib/qrPass.ts.
EXPO_PUBLIC_QR_PASS_SECRET=
