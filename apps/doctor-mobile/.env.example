EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Doit être EXACTEMENT la même valeur que EXPO_PUBLIC_QR_PASS_SECRET dans
# apps/donor-mobile/.env — c'est ce qui permet à cette app de déchiffrer les
# pass générés côté donneur. Même avertissement que côté donneur : cette clé
# est embarquée dans le bundle client des DEUX apps, donc extractible par
# quiconque les décompile. Ce n'est pas une vraie confidentialité contre un
# attaquant technique, seulement une protection contre un scan grand public.
EXPO_PUBLIC_QR_PASS_SECRET=
