{
  "expo": {
    "name": "doctor-mobile",
    "slug": "doctor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "sn.dred.doctor",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "D.RED utilise la caméra pour scanner le pass QR chiffré des donneurs."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "D.RED utilise ta position pour centrer les campagnes et alertes d'urgence que tu crées."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9899bfa2-45b0-4d61-9c31-df0468f7a095"
      }
    }
  }
}
